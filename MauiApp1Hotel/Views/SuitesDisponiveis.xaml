<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1Hotel.Views.SuitesDisponiveis"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="18">

            <!-- Cabeçalho -->
            <VerticalStackLayout Spacing="5"
                                 Margin="0,15,0,10">

                <Label Text="HOTEL RESERVA"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       CharacterSpacing="2" />

                <Label Text="Conheça Nossas Suítes"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Gray900}" />

                <Label Text="Encontre a acomodação ideal para sua estadia."
                       FontSize="14"
                       TextColor="{StaticResource Gray500}" />

            </VerticalStackLayout>

            <!-- Suíte Super Luxo -->
            <Border Padding="15"
                    Stroke="{StaticResource Gray300}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="White">

                <VerticalStackLayout Spacing="12">

                    <Image Source="suite_super_luxo.png"
                           HeightRequest="180"
                           Aspect="AspectFill" />

                    <Label Text="Suíte Super Luxo"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="Acomodação sofisticada, com ambiente espaçoso e acabamento premium."
                           FontSize="14"
                           TextColor="{StaticResource Gray700}" />

                    <Label Text="Diária por adulto: R$ 110,00"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray900}" />

                    <Label Text="Diária por criança: R$ 55,00"
                           TextColor="{StaticResource Gray700}" />

                </VerticalStackLayout>
            </Border>

            <!-- Suíte Luxo -->
            <Border Padding="15"
                    Stroke="{StaticResource Gray300}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="White">

                <VerticalStackLayout Spacing="12">

                    <Image Source="suite_luxo.png"
                           HeightRequest="180"
                           Aspect="AspectFill" />

                    <Label Text="Suíte Luxo"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="Acomodação confortável, com decoração moderna e ambiente aconchegante."
                           FontSize="14"
                           TextColor="{StaticResource Gray700}" />

                    <Label Text="Diária por adulto: R$ 80,00"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray900}" />

                    <Label Text="Diária por criança: R$ 40,00"
                           TextColor="{StaticResource Gray700}" />

                </VerticalStackLayout>
            </Border>

            <!-- Suíte Single -->
            <Border Padding="15"
                    Stroke="{StaticResource Gray300}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="White">

                <VerticalStackLayout Spacing="12">

                    <Image Source="suite_single.png"
                           HeightRequest="180"
                           Aspect="AspectFill" />

                    <Label Text="Suíte Single"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="Acomodação compacta e funcional, ideal para uma estadia prática."
                           FontSize="14"
                           TextColor="{StaticResource Gray700}" />

                    <Label Text="Diária por adulto: R$ 50,00"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray900}" />

                    <Label Text="Diária por criança: R$ 25,00"
                           TextColor="{StaticResource Gray700}" />

                </VerticalStackLayout>
            </Border>

            <!-- Suíte Crise -->
            <Border Padding="15"
                    Stroke="{StaticResource Gray300}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="White">

                <VerticalStackLayout Spacing="12">

                    <Image Source="suite_crise.png"
                           HeightRequest="180"
                           Aspect="AspectFill" />

                    <Label Text="Suíte Crise"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="Opção econômica, com estrutura básica para uma hospedagem confortável."
                           FontSize="14"
                           TextColor="{StaticResource Gray700}" />

                    <Label Text="Diária por adulto: R$ 25,00"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray900}" />

                    <Label Text="Diária por criança: R$ 12,50"
                           TextColor="{StaticResource Gray700}" />

                </VerticalStackLayout>
            </Border>

            <!-- Botão Voltar -->
            <Button Text="Voltar"
                    Clicked="OnVoltarClicked"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,5,0,15" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
