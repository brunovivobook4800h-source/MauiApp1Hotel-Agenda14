<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1Hotel.Views.ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="18">

            <!-- Cabeçalho -->
            <VerticalStackLayout Spacing="5"
                                 Margin="0,15,0,10">

                <Label Text="HOTEL RESERVA"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       CharacterSpacing="2" />

                <Label Text="Cálculo da Diária"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Gray900}" />

                <Label Text="Planeje sua estadia com conforto."
                       FontSize="14"
                       TextColor="{StaticResource Gray500}" />

            </VerticalStackLayout>

            <!-- Formulário -->
            <Border Padding="18"
                    Stroke="{StaticResource Gray300}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="White">

                <VerticalStackLayout Spacing="18">

                    <!-- Hóspedes -->
                    <Label Text="HÓSPEDES"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="*,Auto,Auto"
                          RowSpacing="12"
                          ColumnSpacing="10">

                        <!-- Adultos -->
                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Text="Adultos"
                               VerticalOptions="Center"
                               TextColor="{StaticResource Gray900}" />

                        <Label Grid.Row="0"
                               Grid.Column="1"
                               Text="{Binding Source={x:Reference stp_adultos}, Path=Value, StringFormat='{0:F0}'}"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               TextColor="{StaticResource Primary}" />

                        <Stepper Grid.Row="0"
                                 Grid.Column="2"
                                 x:Name="stp_adultos"
                                 Minimum="0"
                                 Maximum="10"
                                 Increment="1"
                                 Value="1" />

                        <!-- Crianças -->
                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Text="Crianças"
                               VerticalOptions="Center"
                               TextColor="{StaticResource Gray900}" />

                        <Label Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding Source={x:Reference stp_criancas}, Path=Value, StringFormat='{0:F0}'}"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               TextColor="{StaticResource Primary}" />

                        <Stepper Grid.Row="1"
                                 Grid.Column="2"
                                 x:Name="stp_criancas"
                                 Minimum="0"
                                 Maximum="10"
                                 Increment="1"
                                 Value="0" />

                    </Grid>

                    <!-- Seleção da suíte -->
                    <Border Padding="12"
                            Stroke="{StaticResource Gray300}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource Gray100}">

                        <VerticalStackLayout Spacing="8">

                            <Label Text="ESCOLHA SUA SUÍTE"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />

                            <Picker x:Name="pck_quarto"
                                    Title="Selecione sua Acomodação"
                                    ItemDisplayBinding="{Binding Descricao}"
                                    TextColor="{StaticResource Gray900}"
                                    TitleColor="{StaticResource Gray500}" />

                            <!-- Novo botão -->
                            <Button Text="Conheça Nossas Suítes"
                                    Clicked="OnSuitesClicked"
                                    BackgroundColor="{StaticResource Secondary}"
                                    TextColor="{StaticResource Primary}"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    HeightRequest="45" />

                        </VerticalStackLayout>
                    </Border>

                    <!-- Datas da hospedagem -->
                    <Border Padding="12"
                            Stroke="{StaticResource Gray300}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource Gray100}">

                        <VerticalStackLayout Spacing="12">

                            <Label Text="PERÍODO DA ESTADIA"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />

                            <Grid ColumnDefinitions="90,*"
                                  RowDefinitions="Auto,Auto"
                                  RowSpacing="10">

                                <!-- Check-in -->
                                <Label Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Check-in:"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource Gray900}" />

                                <DatePicker Grid.Row="0"
                                            Grid.Column="1"
                                            x:Name="dtpck_checkin"
                                            DateSelected="dtpck_checkin_DateSelected"
                                            Format="dd/MM/yyyy"
                                            TextColor="{StaticResource Gray900}" />

                                <!-- Check-out -->
                                <Label Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Check-out:"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource Gray900}" />

                                <DatePicker Grid.Row="1"
                                            Grid.Column="1"
                                            x:Name="dtpck_checkout"
                                            Format="dd/MM/yyyy"
                                            TextColor="{StaticResource Gray900}" />

                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Botão Avançar -->
                    <Button Text="Avançar"
                            Clicked="Button_Clicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="50" />

                    <!-- Botão Sobre -->
                    <Button Text="Sobre o aplicativo"
                            Clicked="OnSobreClicked"
                            BackgroundColor="{StaticResource Secondary}"
                            TextColor="{StaticResource Primary}"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="45" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
