<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1Hotel.Views.HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Padding="20"
                             Spacing="18">

            <!-- Cabeçalho -->
            <VerticalStackLayout Spacing="5"
                                 Margin="0,15,0,10">

                <Label Text="HOTEL RESERVA"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       CharacterSpacing="2" />

                <Label Text="Resumo da Hospedagem"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Gray900}" />

                <Label Text="Confira os detalhes da sua estadia."
                       FontSize="14"
                       TextColor="{StaticResource Gray500}" />

            </VerticalStackLayout>

            <!-- Cartão de resumo -->
            <Border Padding="18"
                    Stroke="{StaticResource Gray300}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="White">

                <VerticalStackLayout Spacing="18">

                    <Label Text="DETALHES DA RESERVA"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <!-- Acomodação -->
                    <VerticalStackLayout Spacing="5">

                        <Label Text="Acomodação"
                               FontSize="13"
                               TextColor="{StaticResource Gray500}" />

                        <Label Text="Suíte Super Luxo"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray900}" />

                    </VerticalStackLayout>

                    <BoxView HeightRequest="1"
                             Color="{StaticResource Gray300}" />

                    <!-- Hóspedes -->
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="15">

                        <VerticalStackLayout Grid.Column="0"
                                             Spacing="5">

                            <Label Text="Adultos"
                                   FontSize="13"
                                   TextColor="{StaticResource Gray500}" />

                            <Label Text="2"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Gray900}" />

                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="5">

                            <Label Text="Crianças"
                                   FontSize="13"
                                   TextColor="{StaticResource Gray500}" />

                            <Label Text="1"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Gray900}" />

                        </VerticalStackLayout>

                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="{StaticResource Gray300}" />

                    <!-- Datas -->
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="15">

                        <VerticalStackLayout Grid.Column="0"
                                             Spacing="5">

                            <Label Text="Check-in"
                                   FontSize="13"
                                   TextColor="{StaticResource Gray500}" />

                            <Label Text="27/05/2024"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Gray900}" />

                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="5">

                            <Label Text="Check-out"
                                   FontSize="13"
                                   TextColor="{StaticResource Gray500}" />

                            <Label Text="30/05/2024"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Gray900}" />

                        </VerticalStackLayout>

                    </Grid>

                    <!-- Quantidade de diárias -->
                    <Grid ColumnDefinitions="*,Auto">

                        <Label Grid.Column="0"
                               Text="Quantidade de diárias"
                               FontSize="14"
                               TextColor="{StaticResource Gray900}" />

                        <Label Grid.Column="1"
                               Text="3"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray900}" />

                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="{StaticResource Gray300}" />

                    <!-- Valor total -->
                    <Grid ColumnDefinitions="*,Auto">

                        <Label Grid.Column="0"
                               Text="Valor total"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center" />

                        <Label Grid.Column="1"
                               Text="R$ 750,00"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />

                    </Grid>

                    <!-- Botão Voltar -->
                    <Button Text="Voltar"
                            Clicked="Button_Clicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="50" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
